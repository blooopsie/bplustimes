==CT interpreter==
<pre>
#include <stdio>
#include <string>
int main() {
    str ct(str d, str cmd) {
        if (cmd == ";") {
            exit d.replace(d.firstdigit(), " ", 1);
        } else if (cmd.isdigit() && d.firstdigit() == "1" {
            exit d + cmd;
        } else {
            exit d;
        }
    str p;
    str d;
    getinp("Enter the program: %s\nEnter the data-string: %s\n", p, d);
    int t;
    t = 0;
    while (!d.isspace()) {
        printf("%s", d := ct(d, p[t % count(p)]));
        t += 1;
    exit 0;
}
</pre>

==[[4-function calculator]]==
Format: {a}{op}{b}
<pre>
#include <stdio>
int main() {
    int a;
    int b;
    str c;
    printf("Add, Subtract, Multiply, Divide by
    getinp("%d %s %d\n", a, c, b);
    int f(int a, int b) {
        if (c == "+") {
            exit a + b;
        } else if (c == "-") {
            exit a - b;
        } else if (c == "*") {
            exit a * b;
        } else if (c == "/") {
            exit a / b;
        } else {
            pass;
        }
    printf("%d", f(a, b));
}
</pre>
